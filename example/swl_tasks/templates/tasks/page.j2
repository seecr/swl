{#
 # The task list page, in one of SWL's layouts (swl/templates/swl/layouts/: sidebar, topbar or
 # retro; the switch in the top bar). The layout brings the menu (swl.set_menu in app.py), the
 # dialog and the context menu; everything else SWL needs comes from swl/base.j2 (styles, htmx,
 # the toast). This page fills the layout's blocks: brand, toolbar and content.
 #
 # It works with each CSS framework SWL supports (python -m swl_tasks --framework swl|bootstrap|bulma):
 # form elements and buttons get their classes from SWL.ui, the layout comes from swl.css
 # (swl-nav, swl-container, swl-columns) and the example's own tasks.css.
 #}
{% extends "swl/layouts/" ~ layout ~ ".j2" %}
{% from "swl/placeholder.j2" import placeholder %}

{% block head_extra %}
        <script src="/static/swl/theme.js"></script>
        <link rel="stylesheet" href="/example/tasks.css">
{% endblock %}

{% block brand %}SWL Tasks <span id="task-counts" class="swl-badge"></span>{% endblock %}

{# the language, CSS framework, layout and colours: on the right of the layout's bar #}
{% block toolbar %}{% include "tasks/style_switch.j2" %}{% endblock %}

{% block content %}
    {#
     # A plain form that holds "where you are": the filter fields, the view (list or tree), and
     # (hidden) the selected task and tab. The task list and the detail panel include it in their requests (hx-include), so every
     # action knows the whole screen and can put it in the url (views.page_url).
     #}
    <form id="filters" class="task-filters">
        <span id="selection" class="swl-hidden">{{ selection_html }}</span>
        <input type="search" name="q" value="{{ q }}" class="{{ SWL.ui.input }}" placeholder="{{ _('Search tasks...') }}" aria-label="{{ _('Search tasks') }}">
        <select name="status" class="{{ SWL.ui.select }}" aria-label="{{ _('Show') }}">
            {% for value in statuses %}
            <option value="{{ value }}" {{ "selected" if value == status }}>{{ _(labels[value]) }}</option>
            {% endfor %}
        </select>
        <select name="view" class="{{ SWL.ui.select }}" aria-label="{{ _('View') }}">
            {% for value in view_names %}
            <option value="{{ value }}" {{ "selected" if value == view }}>{{ _(labels[value]) }}</option>
            {% endfor %}
        </select>
        <button type="button" class="{{ SWL.ui.button_primary }}" hx-post="{{ register('task_new') }}">
            <i class="bi bi-plus-lg"></i> {{ _("New task") }}
        </button>
    </form>

    {#
     # The task list loads itself from the tasks_list action:
     #  - when the page loads,
     #  - 300ms after the last change in the #filters form (and posts that form),
     #  - when an action rehydrates "tasks-list",
     #  - when the server signals that "tasks" changed (websocket.js), e.g. in another tab.
     #}
    <div class="swl-columns">
        <div class="swl-wide">
            {{ placeholder("tasks-list", register('tasks_list'),
                           trigger="input delay:300ms from:#filters",
                           attrs={"hx-include": "#filters", "hx-sync": "this:queue last"},
                           on_changed=["tasks"]) }}
        </div>
        <div>
            {#
             # The selected task, on its tabs. The page route renders its content straight away
             # (detail_html), so it is lazy: it does not load when the page loads, only when it is
             # rehydrated (after a change, or a change in another tab).
             #}
            {% call placeholder("task-detail", register('task_detail'), lazy=True,
                                attrs={"hx-include": "#filters", "hx-sync": "this:queue last"},
                                on_changed=["tasks"]) %}{{ detail_html }}{% endcall %}
        </div>
    </div>
{% endblock %}

{% block body_extra %}
<script type="module" id="swl-run" src="/static/swl/swl-run.js"></script>
<script type="module" src="/static/swl/websocket.js"></script>
{# the tree view: tree.js drives jstree (jQuery and jstree come from tree-web-resources.json, see app.py) #}
<script type="module" src="/static/swl/tree.js"></script>
<script src="/example/tasks.js"></script>
{% endblock %}
