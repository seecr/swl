{#
 # Switches for the example: the language, the CSS framework, the layout and light/dark colours.
 #   - The language is the cookie "swl_lang", read by swl.i18n_middleware (app.py); changing it
 #     reloads the page, which the server then renders in that language.
 #   - The framework is a cookie read by FrameworkCookieMiddleware (app.py); changing it reloads
 #     the page, as the page then loads other stylesheets.
 #   - The layout is the cookie "swl_layout", read by the page route (app.py layout_of);
 #     changing it reloads the page.
 #   - Light/dark/auto is swl/static/swl/theme.js; it changes the page right away.
 # Both are set in static/tasks.js.
 #}
<span class="task-style-switch">
    <select id="language-switch" class="{{ SWL.ui.select }}" aria-label="{{ _('Language') }}" title="{{ _('Language') }}">
        {% for code, name in languages %}
        <option value="{{ code }}" lang="{{ code }}" {{ "selected" if code == SWL.lang }}>{{ name }}</option>
        {% endfor %}
    </select>
    <select id="framework-switch" class="{{ SWL.ui.select }}" aria-label="{{ _('CSS framework') }}" title="{{ _('CSS framework') }}">
        {% for name, label in [("swl", "SWL"), ("bootstrap", "Bootstrap"), ("tabler", "Tabler"), ("bulma", "Bulma")] %}
        <option value="{{ name }}" {{ "selected" if name == SWL.framework }}>{{ label }}</option>
        {% endfor %}
    </select>
    {% if layouts is defined %}
    <select id="layout-switch" class="{{ SWL.ui.select }}" aria-label="{{ _('Layout') }}" title="{{ _('Layout') }}">
        {% for name in layouts %}
        <option value="{{ name }}" {{ "selected" if name == layout }}>{{ name|capitalize }}</option>
        {% endfor %}
    </select>
    {% endif %}
    <button type="button" id="theme-switch" class="{{ SWL.ui.button }} {{ SWL.ui.small }}"
            aria-label="{{ _('Colours: automatic') }}" title="{{ _('Colours: automatic') }}"
            data-title-auto="{{ _('Colours: automatic') }}" data-title-light="{{ _('Colours: light') }}"
            data-title-dark="{{ _('Colours: dark') }}">
        <i class="bi bi-circle-half"></i>
    </button>
</span>
