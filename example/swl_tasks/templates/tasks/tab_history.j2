{# The "History" tab of the detail panel: what happened to the task, newest first. #}
{% if task.history %}
<ul class="swl-list">
    {% for entry in task.history|reverse %}
    <li>
        <span class="swl-muted task-when">{{ entry.at.replace("T", " ") }}</span>
        <span>{{ entry.what }}</span>
    </li>
    {% endfor %}
</ul>
{% else %}
<p class="swl-muted">No history yet.</p>
{% endif %}
