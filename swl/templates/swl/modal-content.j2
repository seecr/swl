{#
 # Base for modal content. Blocks:
 #   modal_title     the title
 #   modal_icon      optional, shown left of the title (e.g. an avatar or an icon)
 #   modal_subtitle  optional, a line below the title
 #   modal_content   the body
 #   modal_footer    optional, buttons at the bottom
 # A button with data-swl-close (or data-bs-dismiss="modal") closes the modal.
 #}
{#
 # The header is a grid (swl.css): the icon, the title and the close button on one row, the
 # subtitle below the title. A long subtitle uses the width under the close button too, so
 # it never pushes the button aside.
 #}
<div class="swl-modal-header{{ ' swl-modal-header-subtitle' if self.modal_subtitle()|trim }}">
    {% if self.modal_icon()|trim %}<div class="swl-modal-icon">{% block modal_icon %}{% endblock %}</div>{% endif %}
    <h5 id="swl-modal-label" class="swl-modal-title">{% block modal_title %}{% endblock %}</h5>
    <button type="button" class="swl-icon-button swl-modal-close" data-swl-close aria-label="{{ _('Close') }}">
        <i class="bi bi-x-lg" title="{{ _('Close') }}"></i>
    </button>
    {% if self.modal_subtitle()|trim %}
    <p class="swl-modal-subtitle">{% block modal_subtitle %}{% endblock %}</p>
    {% endif %}
</div>
<div class="swl-modal-body">{% block modal_content %}{% endblock %}</div>
{% if self.modal_footer()|trim %}
<div class="swl-modal-footer">{% block modal_footer %}{% endblock %}</div>
{% endif %}
