{#
 # The list of users (users_list), inside users.j2. Each row is a form with the username, so the
 # admin switch (user_set_admin) and the delete button (user_delete) post it.
 #   - you cannot change your own admin status or delete yourself;
 #   - an administrator cannot be deleted: switch admin off first;
 #   - only administrators can change anything.
 #}
{% set me = request.user %}
<h6 class="swl-section-title"><i class="{{ SWL.icons.user_list }} swl-icon"></i> {% trans count=users|length %}{{ count }} user{% pluralize %}{{ count }} users{% endtrans %}</h6>
<ul class="swl-list">
    {% for user in users|sort(attribute="username") %}
    {% set is_me = user['username'] == me.username %}
    <li>
        <form class="swl-list-row">
            <input type="hidden" name="username" value="{{ user['username'] }}">
            <span class="swl-avatar {{ 'swl-avatar-admin' if user['admin'] }}" aria-hidden="true"><i class="{{ SWL.icons.user }} swl-icon"></i></span>
            <div class="swl-grow">
                <div>
                    <strong>{{ user['username'] }}</strong>
                    {% if is_me %}<span class="swl-badge">{{ _("You") }}</span>{% endif %}
                </div>
                <div class="swl-muted swl-small">{{ _("Administrator") if user['admin'] else _("User") }}</div>
            </div>
            <span title="{{ _('You cannot change your own administrator status') if is_me else _('Administrator') }}">
                <input class="swl-switch" type="checkbox" role="switch" name="admin"
                       aria-label="{{ _('Administrator: %(username)s', username=user['username']) }}"
                       hx-post="{{ register('user_set_admin') }}"
                       {{ "checked" if user['admin'] }} {{ "disabled" if is_me or not me.admin }}>
            </span>
            {% if is_me %}
                {% set delete_title = _("You cannot delete yourself") %}
            {% elif user['admin'] %}
                {% set delete_title = _("Switch administrator off before deleting this user") %}
            {% else %}
                {% set delete_title = _("Delete %(username)s", username=user['username']) %}
            {% endif %}
            <span title="{{ delete_title }}">
                <button type="button" class="swl-icon-button swl-icon-danger" aria-label="{{ delete_title }}"
                        hx-post="{{ register('user_delete') }}" hx-confirm="{{ _("Delete user '%(username)s'?", username=user['username']) }}"
                        {{ "disabled" if is_me or user['admin'] or not me.admin }}>
                    <i class="{{ SWL.icons.delete }} swl-icon"></i>
                </button>
            </span>
        </form>
    </li>
    {% endfor %}
</ul>
