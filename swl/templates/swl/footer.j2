{% macro footer(year, name, version) %}
<footer class="footer mt-auto bg-seecr fw-lighter px-2">
    <div class="d-flex flex-row justify-content-between">
        <div class="d-flex flex-row gap-1">
            <span>Copyright &copy; {{ year }}</span>
            <span class="seecr-orange">|</span>
            <a href="https://seecr.nl" target="_blank">seecr</a>
        </div>
        <span>{{ name }} {{ VERSION }}</span>
    </div>
</footer>
{% endmacro %}
