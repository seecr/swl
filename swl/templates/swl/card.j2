{% macro card(title, icon=None) %}
<div class="card mb-3">
    <div class="card-header">
        <div class="d-flex flex-row">
            <div class="w-100">
                <h5 class="m-0">
                    {% if icon is not none %}
                        <i class="bi bi-{{ icon }}"></i>
                        <span class="ps-2">{{ title }}</span>
                    {% else %}
                        <span>{{ title }}</span>
                    {% endif %}
                </h5>
            </div>
        </div>
    </div>
    <div class="card-body">
        {{ caller() }}
    </div>
</div>
{% endmacro %}
