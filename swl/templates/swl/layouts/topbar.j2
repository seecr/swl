{#
 # Layout "topbar": the app's name and the menu in a bar at the top, on its right the
 # toolbar, "Manage" and the user's menu; the page below it in block "content". On a narrow
 # screen the menu opens from a button in the bar (a popover). The menu: swl.set_menu
 # (swl/menu.py).
 #
 #     {% extends "swl/layouts/topbar.j2" %}
 #     {% block content %}...{% endblock %}
 #
 # Blocks: brand, toolbar, content (as layouts/sidebar.j2).
 #}
{%- set body_class = "swl-layout swl-layout-topbar" -%}
{%- extends "swl/base.j2" -%}
{% import "swl/layouts/lib.j2" as swl_layout %}

{% block body %}
{% set menu = SWL.menu.for_request(request) %}
{{ swl_layout.assets() }}
<header class="swl-layout-bar">
    <a class="swl-layout-brand" href="/">{% block brand %}{{ SWL.menu.title }}{% endblock %}</a>
    {% if menu.main %}
    <button type="button" class="swl-layout-link swl-layout-menu-button" popovertarget="swl-layout-nav" aria-label="{{ _('Menu') }}">
        <i class="bi bi-list" aria-hidden="true"></i>
    </button>
    {% endif %}
    <nav id="swl-layout-nav" class="swl-layout-topnav" popover aria-label="{{ _('Menu') }}">
        <ul class="swl-layout-items">
            {% for item in menu.main %}<li>{{ swl_layout.menu_link(item, request) }}</li>{% endfor %}
        </ul>
    </nav>
    <div class="swl-layout-tools">
        {% block toolbar %}{% endblock %}
        {{ swl_layout.tools(menu, request) }}
    </div>
</header>
<main class="swl-layout-content">
    {% block content %}{% endblock %}
</main>
{% include "swl/modal.j2" %}
{% include "swl/contextmenu.j2" %}
{% endblock %}
