{#
 # Layout "sidebar": the menu on the left, a bar at the top with the toolbar, "Manage" and
 # the user's menu, the page in block "content". On a narrow screen the menu opens from a
 # button in the bar (a popover). The menu: swl.set_menu (swl/menu.py).
 #
 #     {% extends "swl/layouts/sidebar.j2" %}
 #     {% block content %}...{% endblock %}
 #
 # Blocks: brand (the app's name, default the menu's title), toolbar (more in the bar),
 # content. head_extra and body_extra are base.j2's.
 #}
{%- set body_class = "swl-layout swl-layout-sidebar" -%}
{%- extends "swl/base.j2" -%}
{% import "swl/layouts/lib.j2" as swl_layout %}

{% block body %}
{% set menu = SWL.menu.for_request(request) %}
{{ swl_layout.assets() }}
<div class="swl-layout-frame">
    <nav id="swl-layout-nav" class="swl-layout-side" popover aria-label="{{ _('Menu') }}">
        <a class="swl-layout-brand" href="/">{% block brand %}{{ SWL.menu.title }}{% endblock %}</a>
        <ul class="swl-layout-items">
            {% for item in menu.main %}<li>{{ swl_layout.menu_link(item, request) }}</li>{% endfor %}
        </ul>
    </nav>
    <div class="swl-layout-main">
        <header class="swl-layout-bar">
            <button type="button" class="swl-layout-link swl-layout-menu-button" popovertarget="swl-layout-nav" aria-label="{{ _('Menu') }}">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <span class="swl-layout-bar-title">{{ menu.title }}</span>
            <div class="swl-layout-tools">
                {% block toolbar %}{% endblock %}
                {{ swl_layout.tools(menu, request) }}
            </div>
        </header>
        <main class="swl-layout-content">
            {% block content %}{% endblock %}
        </main>
    </div>
</div>
{% include "swl/modal.j2" %}
{% include "swl/contextmenu.j2" %}
{% endblock %}
