{# Change password (change_password). The form posts itself, so Enter works too. #}
<section class="swl-section">
    <h6 class="swl-section-title"><i class="bi bi-key"></i> Change password</h6>
    <p class="swl-muted swl-small">Enter your current password, then the new one twice. A password has at least 8 characters.</p>
    <form class="swl-stack" hx-post="{{ register('change_password') }}">
        <input type="hidden" name="username" value="{{ user['username'] }}">
        {# for password managers: the account the password belongs to #}
        <input type="text" name="account" value="{{ user['username'] }}" autocomplete="username" class="swl-hidden" tabindex="-1" aria-hidden="true">
        <div class="swl-field">
            <label for="swl-current-password">Current password</label>
            <input type="password" class="{{ SWL.ui.input }}" id="swl-current-password" name="current_password"
                   autocomplete="current-password" required>
        </div>
        <div class="swl-row">
            <div class="swl-field">
                <label for="swl-new-password">New password</label>
                <input type="password" class="{{ SWL.ui.input }}" id="swl-new-password" name="new_password"
                       autocomplete="new-password" minlength="8" required>
            </div>
            <div class="swl-field">
                <label for="swl-new-password-repeat">Repeat new password</label>
                <input type="password" class="{{ SWL.ui.input }}" id="swl-new-password-repeat" name="new_password_repeat"
                       autocomplete="new-password" minlength="8" required>
            </div>
        </div>
        <div class="swl-end">
            <button type="submit" class="{{ SWL.ui.button_primary }}"><i class="bi bi-check2"></i> Change password</button>
        </div>
    </form>
</section>
