#: swl/i18n.py:299
msgid "Saved"
msgstr "Enregistré"

#: swl/templates/swl/account.j2:17
msgid "My account"
msgstr "Mon compte"

#: swl/templates/swl/account.j2:18 swl/templates/swl/users.j2:41
#: swl/templates/swl/users_list.j2:34 swl/templates/swl/users_list.j2:36
msgid "Administrator"
msgstr "Administrateur"

#: swl/templates/swl/account.j2:18 swl/templates/swl/users_list.j2:34
msgid "User"
msgstr "Utilisateur"

#: swl/templates/swl/account_password.j2:15
#: swl/templates/swl/account_password.j2:39
msgid "Change password"
msgstr "Changer le mot de passe"

#: swl/templates/swl/account_password.j2:16
msgid ""
"Enter your current password, then the new one twice. A password has at "
"least 8 characters."
msgstr ""
"Saisissez votre mot de passe actuel, puis deux fois le nouveau. Un mot de"
" passe compte au moins 8 caractères."

#: swl/templates/swl/account_password.j2:22
msgid "Current password"
msgstr "Mot de passe actuel"

#: swl/templates/swl/account_password.j2:28
msgid "New password"
msgstr "Nouveau mot de passe"

#: swl/templates/swl/account_password.j2:33
msgid "Repeat new password"
msgstr "Répétez le nouveau mot de passe"

#: swl/templates/swl/alert.j2:15 swl/templates/swl/modal-content.j2:30
#: swl/templates/swl/modal-content.j2:31
msgid "Close"
msgstr "Fermer"

#: swl/templates/swl/inputs.j2:33
msgid "optional"
msgstr "facultatif"

#: swl/templates/swl/users.j2:18
msgid "Users"
msgstr "Utilisateurs"

#: swl/templates/swl/users.j2:19
msgid "Who can log in, and who is an administrator"
msgstr "Qui peut se connecter, et qui est administrateur"

#: swl/templates/swl/users.j2:25
msgid "Add a user"
msgstr "Ajouter un utilisateur"

#: swl/templates/swl/users.j2:29
msgid "Username"
msgstr "Nom d'utilisateur"

#: swl/templates/swl/users.j2:31
msgid "At least 3 characters, no spaces"
msgstr "Au moins 3 caractères, sans espaces"

#: swl/templates/swl/users.j2:35
msgid "Password"
msgstr "Mot de passe"

#: swl/templates/swl/users.j2:44
msgid "Add user"
msgstr "Ajouter l'utilisateur"

#: swl/templates/swl/users.j2:49
msgid "Only administrators can add, change or delete users."
msgstr ""
"Seuls les administrateurs peuvent ajouter, modifier ou supprimer des "
"utilisateurs."

#: swl/templates/swl/users_list.j2:21
#, python-format
msgid "%(count)s user"
msgid_plural "%(count)s users"
msgstr[0] "%(count)s utilisateur"
msgstr[1] "%(count)s utilisateurs"

#: swl/templates/swl/users_list.j2:32
msgid "You"
msgstr "Vous"

#: swl/templates/swl/users_list.j2:36
msgid "You cannot change your own administrator status"
msgstr "Vous ne pouvez pas modifier votre propre statut d'administrateur"

#: swl/templates/swl/users_list.j2:38
#, python-format
msgid "Administrator: %(username)s"
msgstr "Administrateur : %(username)s"

#: swl/templates/swl/users_list.j2:43
msgid "You cannot delete yourself"
msgstr "Vous ne pouvez pas vous supprimer vous-même"

#: swl/templates/swl/users_list.j2:45
msgid "Switch administrator off before deleting this user"
msgstr "Désactivez administrateur avant de supprimer cet utilisateur"

#: swl/templates/swl/users_list.j2:47
#, python-format
msgid "Delete %(username)s"
msgstr "Supprimer %(username)s"

#: swl/templates/swl/users_list.j2:51
#, python-format
msgid "Delete user '%(username)s'?"
msgstr "Supprimer l'utilisateur '%(username)s' ?"

#: swl/views/account.py:38
msgid "Unauthorized; only admin-users can change other users passwords"
msgstr ""
"Non autorisé ; seuls les administrateurs peuvent changer le mot de passe "
"d'autres utilisateurs"

#: swl/views/account.py:42
msgid "Password incorrect"
msgstr "Mot de passe incorrect"

#: swl/views/account.py:45
msgid "Passwords do not match"
msgstr "Les mots de passe ne correspondent pas"

#: swl/views/account.py:49
msgid "New password should be at least 8 characters long"
msgstr "Le nouveau mot de passe doit compter au moins 8 caractères"

#: swl/views/account.py:53
msgid "Password changed"
msgstr "Mot de passe modifié"

#: swl/views/account.py:86
msgid "Username invalid; longer than 3 character and no spaces"
msgstr "Nom d'utilisateur invalide ; au moins 3 caractères et sans espaces"

#: swl/views/account.py:91
msgid "Unauthorized; only admin-users can create users"
msgstr "Non autorisé ; seuls les administrateurs peuvent créer des utilisateurs"

#: swl/views/account.py:95
msgid "Username already in use"
msgstr "Ce nom d'utilisateur est déjà utilisé"

#: swl/views/account.py:103
#, python-format
msgid "User '%(username)s' added"
msgstr "Utilisateur '%(username)s' ajouté"

#: swl/views/account.py:109
msgid "Unauthorized; only admin-users can delete users"
msgstr ""
"Non autorisé ; seuls les administrateurs peuvent supprimer des "
"utilisateurs"

#: swl/views/account.py:114
msgid "No such user"
msgstr "Cet utilisateur n'existe pas"

#: swl/views/account.py:118
msgid "Deleting own user not allowed"
msgstr "Vous ne pouvez pas supprimer votre propre utilisateur"

#: swl/views/account.py:133
msgid "Unauthorized; only admin-users can set admin on users"
msgstr ""
"Non autorisé ; seuls les administrateurs peuvent attribuer les droits "
"d'administrateur"

#: swl/views/account.py:142
msgid "Cannot change admin status of own user"
msgstr "Vous ne pouvez pas modifier votre propre statut d'administrateur"

#: swl/views/account.py:165
msgid "Invalid login credentials"
msgstr "Nom d'utilisateur ou mot de passe incorrect"

